{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/graphql",
	"version": "0.1.0",
	"description": "Pluxel builtin plugin: GraphQL runtime + codegen",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"build": "pluxel build",
		"build:builtin": "pluxel build",
		"test": "bun test"
	},
	"dependencies": {
		"@gqloom/core": "^0.15.0",
		"@gqloom/valibot": "^0.15.0",
		"@gqty/cli": "^5.0.0",
		"graphql": "^16.12.0",
		"graphql-yoga": "^5.18.0",
		"valibot": "^1.2.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs"
}

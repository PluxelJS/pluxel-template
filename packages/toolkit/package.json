{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/toolkit",
	"version": "0.1.0",
	"description": "Shared toolkit wrappers for Pluxel packages/plugins.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./cache": {
			"@pluxel/hmr": "./src/cache.ts",
			"default": "./dist/cache.mjs"
		},
		"./hash": {
			"@pluxel/hmr": "./src/hash.ts",
			"default": "./dist/hash.mjs"
		},
		"./id": {
			"@pluxel/hmr": "./src/id.ts",
			"default": "./dist/id.mjs"
		},
		"./ohash": {
			"@pluxel/hmr": "./src/ohash.ts",
			"default": "./dist/ohash.mjs"
		},
		"./option": {
			"@pluxel/hmr": "./src/option/index.ts",
			"default": "./dist/option.mjs"
		},
		"./pacer": {
			"@pluxel/hmr": "./src/pacer.ts",
			"default": "./dist/pacer.mjs"
		},
		"./time": {
			"@pluxel/hmr": "./src/time.ts",
			"default": "./dist/time.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "pnpm run typecheck && bun test"
	},
	"devDependencies": {
		"@neophi/sieve-cache": "^1.5.0",
		"@tanstack/pacer": "^0.17.3",
		"lru-cache": "^11.2.4",
		"nanoid": "^5.1.6",
		"ohash": "^2.0.11",
		"option-t": "^55.1.1",
		"rapidhash-js": "^3.0.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./cache": "./dist/cache.mjs",
			"./hash": "./dist/hash.mjs",
			"./id": "./dist/id.mjs",
			"./ohash": "./dist/ohash.mjs",
			"./option": "./dist/option.mjs",
			"./pacer": "./dist/pacer.mjs",
			"./time": "./dist/time.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

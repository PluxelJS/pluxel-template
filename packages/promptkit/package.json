{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/promptkit",
	"version": "0.1.0",
	"description": "Pure-function prompt/LLM helpers (structured encoders, etc).",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./toon": {
			"@pluxel/hmr": "./src/toon.ts",
			"default": "./dist/toon.mjs"
		},
		"./mdream": {
			"@pluxel/hmr": "./src/mdream/index.ts",
			"default": "./dist/mdream.mjs"
		},
		"./mdream/plugins": {
			"@pluxel/hmr": "./src/mdream/plugins.ts",
			"default": "./dist/mdream-plugins.mjs"
		},
		"./mdream/preset/minimal": {
			"@pluxel/hmr": "./src/mdream/preset/minimal.ts",
			"default": "./dist/mdream-preset-minimal.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"test": "pnpm run typecheck && pnpm exec vitest run -c ../../vitest.config.ts --project @pluxel/promptkit"
	},
	"dependencies": {
		"@toon-format/toon": "^2.1.0",
		"mdream": "^0.10.1"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./toon": "./dist/toon.mjs",
			"./mdream": "./dist/mdream.mjs",
			"./mdream/plugins": "./dist/mdream-plugins.mjs",
			"./mdream/preset/minimal": "./dist/mdream-preset-minimal.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/cmd",
	"version": "0.1.0",
	"description": "Composable command/op runtime (Standard Schema v1 + schema-derived text grammar).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm run typecheck && vitest run -c ./vitest.config.ts"
	},
	"dependencies": {
		"@sinclair/parsebox": "^0.11.1",
		"@standard-schema/spec": "^1.1.0",
		"@valibot/to-json-schema": "^1.5.0",
		"option-t": "^55.1.1"
	},
	"devDependencies": {
		"valibot": "^1.2.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

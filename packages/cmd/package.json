{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/cmd",
	"version": "0.1.0",
	"description": "Composable command/op runtime (TypeBox JSON Schema + schema-derived text grammar).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json",
		"test": "pnpm run typecheck && vitest run -c ./vitest.config.ts"
	},
	"dependencies": {
		"@sinclair/parsebox": "^0.11.1",
		"@sinclair/typebox": "^0.34.41",
		"option-t": "^55.1.1"
	},
	"devDependencies": {},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

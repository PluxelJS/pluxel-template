{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-debit",
	"version": "0.1.0",
	"description": "TigerBeetle-compatible ledger service plugin (token + persistent local backend).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"test": "bun test --conditions=@pluxel/hmr"
	},
	"dependencies": {
		"tigerbeetle-node": "^0.16.68"
	},
	"peerDependencies": {
		"pluxel-plugin-mikro-orm": "workspace:^"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	},
	"pluxel": {
		"dependOn": {
			"required": [],
			"optional": [
				"pluxel-plugin-mikro-orm"
			]
		}
	}
}

{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/univer-headless",
	"version": "0.1.0",
	"description": "Headless Univer helpers: a minimal Univer -> AI call bridge (service-only).",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.typecheck.json"
	},
	"dependencies": {
		"@pluxel/univer-protocol": "workspace:^",
		"@univerjs/core": "^0.15.4",
		"@univerjs/preset-sheets-node-core": "^0.15.4",
		"@univerjs/presets": "^0.15.4"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-kv",
	"version": "0.1.0",
	"description": "KV service plugin (token + memory backend).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./cache": {
			"@pluxel/hmr": "./src/cache.ts",
			"default": "./dist/cache.mjs"
		},
		"./decorators": {
			"@pluxel/hmr": "./src/decorators.ts",
			"default": "./dist/decorators.mjs"
		},
		"./rates": {
			"@pluxel/hmr": "./src/rates.ts",
			"default": "./dist/rates.mjs"
		},
		"./types": {
			"@pluxel/hmr": "./src/types.ts",
			"default": "./dist/types.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"test": "vitest run -c ./vitest.config.ts"
	},
	"dependencies": {
		"@isaacs/ttlcache": "^2.1.4"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./cache": "./dist/cache.mjs",
			"./decorators": "./dist/decorators.mjs",
			"./rates": "./dist/rates.mjs",
			"./types": "./dist/types.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

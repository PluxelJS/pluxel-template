{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-ledger",
	"version": "0.1.0",
	"description": "TigerBeetle-compatible ledger token + builders (core abstraction).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build"
	},
	"dependencies": {
		"tigerbeetle-node": "^0.16.68"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

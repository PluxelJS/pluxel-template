{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-s3mini",
	"version": "0.1.0",
	"description": "S3 client service plugin (s3mini) with caller-scoped key prefixes.",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "pnpm exec vitest run -c ./vitest.config.ts",
		"build": "pluxel build"
	},
	"dependencies": {
		"s3mini": "^0.9.1"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

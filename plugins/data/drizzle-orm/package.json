{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-drizzle-orm",
	"version": "0.1.0",
	"description": "Drizzle ORM (sqlite) + libsql fixed combo service plugin with MikroOrm-like scoped table registration.",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"!**/*.map"
	],
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "pluxel build",
		"test": "bun test --conditions=@pluxel/hmr"
	},
	"dependencies": {
		"@libsql/client": "^0.17.0",
		"drizzle-orm": "^0.45.1"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

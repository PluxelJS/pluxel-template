{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-otlp-viewer",
	"version": "0.1.0",
	"description": "Dev-time OTLP viewer UI: tap pluxel-plugin-otlp and store locally in DuckDB for fast browsing/querying.",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"ui",
		"!**/*.map"
	],
	"scripts": {
		"test": "pnpm run typecheck && pnpm exec vitest run -c ./vitest.config.ts --passWithNoTests",
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@duckdb/node-api": "1.4.4-r.1",
		"@valibot/to-json-schema": "^1.5.0",
		"mcp-lite": "^0.10.0",
		"valibot": "^1.2.0",
		"pluxel-plugin-otlp": "workspace:^"
	},
	"pluxel": {
		"dependOn": {
			"required": [
				"pluxel-plugin-otlp"
			],
			"optional": []
		}
	}
}

{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-otlp",
	"version": "0.1.0",
	"description": "OTLP hub plugin: push batched/backpressured logs/traces/metrics via OTLP/HTTP JSON.",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./otel": {
			"@pluxel/hmr": "./src/otel.ts",
			"default": "./dist/otel.mjs"
		},
		"./decorators": {
			"@pluxel/hmr": "./src/decorators.ts",
			"default": "./dist/decorators.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "pnpm run typecheck && vitest run -c ./vitest.config.ts",
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.0"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./otel": "./dist/otel.mjs",
			"./decorators": "./dist/decorators.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

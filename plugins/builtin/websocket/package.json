{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/websocket",
	"version": "0.1.0",
	"description": "Pluxel builtin plugin: WebSocket manager (tracked, disposable connections).",
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"!**/*.map",
		"dist"
	],
	"scripts": {
		"build": "pluxel build",
		"build:builtin": "pluxel build"
	},
	"dependencies": {
		"ws": "^8.19.0"
	},
	"devDependencies": {
		"@types/ws": "^8.18.1"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}

{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-univer",
	"version": "0.1.0",
	"description": "Core Univer service plugin: manages Univer plugin specs + SSE for the Univer frontend.",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@pluxel/univer-headless": "workspace:^"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}

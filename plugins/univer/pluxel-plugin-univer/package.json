{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-univer",
	"version": "0.1.0",
	"description": "Core Univer UI plugin: embeds Univer in ext.ui and toggles built-in Univer plugins (frontend bundled).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src/ui",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@pluxel/promptkit": "workspace:^",
		"pluxel-plugin-univer-ai": "workspace:*",
		"pluxel-plugin-univer-workbooks": "workspace:*",
		"@univerjs/core": "^0.15.4",
		"@univerjs/design": "^0.15.4",
		"@univerjs/engine-formula": "^0.15.4",
		"@univerjs/engine-render": "^0.15.4",
		"@univerjs/sheets": "^0.15.4",
		"@univerjs/sheets-ui": "^0.15.4",
		"@univerjs/ui": "^0.15.4",
		"@univerjs/watermark": "^0.15.4"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}

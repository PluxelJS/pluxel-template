{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/univer-protocol",
	"version": "0.1.0",
	"description": "Shared Univer <-> Pluxel protocol types (RPC/SSE payloads).",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.typecheck.json"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

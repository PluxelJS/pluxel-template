{
  "$schema": "https://market.pluxel.dev/schema/package.json",
  "name": "pluxel-plugin-univer-watermark",
  "version": "0.1.0",
  "description": "Univer frontend plugin toggle: watermark (backend-controlled, SSE -> Univer web).",
  "type": "module",
  "exports": {
    ".": {
      "@pluxel/hmr": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "!**/*.map"
  ],
  "scripts": {
    "build": "pluxel build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "pluxel-plugin-univer": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "pluxel": {
    "dependOn": {
      "required": [
        "pluxel-plugin-univer"
      ],
      "optional": []
    }
  }
}
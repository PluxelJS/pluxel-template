{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-univer-ai",
	"version": "0.1.0",
	"description": "Univer AI capability plugin: exposes AI availability via LLMHub profiles (no loopback RPC).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "pnpm run typecheck && vitest run -c ./vitest.config.ts",
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@pluxel/univer-headless": "workspace:^",
		"pluxel-plugin-llm-hub": "workspace:^",
		"pluxel-plugin-univer": "workspace:^"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	}
}

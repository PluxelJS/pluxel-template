{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "@pluxel/univer-headless",
	"version": "0.1.0",
	"description": "Headless Univer helpers: a minimal Univer -> AI call bridge (service-only).",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./protocol": {
			"@pluxel/hmr": "./src/protocol/index.ts",
			"default": "./dist/protocol/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"!**/*.map"
	],
	"scripts": {
		"test": "pnpm run typecheck && pnpm exec vitest run -c ./vitest.config.ts",
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.typecheck.json"
	},
	"dependencies": {
		"@ax-llm/ax": "^16.1.6",
		"@sinclair/typebox": "^0.34.48",
		"@univerjs/core": "^0.15.4",
		"@univerjs/preset-sheets-node-core": "^0.15.4",
		"@univerjs/presets": "^0.15.4"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./protocol": "./dist/protocol/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	}
}

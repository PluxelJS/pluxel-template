{
  "$schema": "https://market.pluxel.dev/schema/package.json",
  "name": "pluxel-plugin-poll-kernel",
  "version": "0.1.0",
  "description": "Poll kernel service plugin (MikroORM).",
  "type": "module",
  "exports": {
    ".": {
      "@pluxel/hmr": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "!**/*.map"
  ],
  "scripts": {
    "build": "pluxel build",
    "test": "vitest run -c ./vitest.config.ts"
  },
  "dependencies": {
    "@pluxel/toolkit": "workspace:^"
  },
  "peerDependencies": {
    "pluxel-plugin-mikro-orm": "workspace:^"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "pluxel": {
    "dependOn": {
      "required": [],
      "optional": [
        "pluxel-plugin-mikro-orm"
      ]
    }
  }
}

{
	"private": true,
	"name": "pluxel-template",
	"type": "module",
	"version": "0.1.0",
	"description": "使用 HMR 管理插件的运行时，让 HMR Build 后以提升加载速度。",
	"scripts": {
		"bootstrap": "sh ./scripts/bootstrap.sh",
		"dev": "turbo build:builtin --filter=./builtin-plugins/* && node src/index.ts",
		"hmr:prompt": "PLUXEL_CLI_SOURCE=1 PLUXEL_HMR_CLI_SOURCE=1 pnpm exec pluxel hmr --start-cmd \"pnpm hmr\"",
		"hmr": "node src/index.ts",
		"hmr:doctor": "PLUXEL_CLI_SOURCE=1 PLUXEL_HMR_CLI_SOURCE=1 pnpm exec pluxel hmr doctor",
		"build": "turbo build",
		"build:builtin": "turbo build:builtin --filter=./builtin-plugins/*",
		"test": "node scripts/test-vitest.mjs",
		"publish": "turbo publish",
		"new": "pluxel new plugin",
		"feat": "pluxel new plugin features"
	},
	"dependencies": {
		"@gqty/react": "^3.1.1",
		"@pluxel/cli": "link:../pluxel/packages/cli",
		"@pluxel/core": "link:../pluxel/packages/core",
		"@pluxel/hmr": "link:../pluxel/packages/hmr",
		"drizzle-orm": "^0.45.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@chatui/core": "^3.6.0",
		"@mantine/core": "^8.3.13",
		"@mantine/hooks": "^8.3.13",
		"@mantine/modals": "^8.3.13",
		"@pluxel/cmd": "workspace:*",
		"@pluxel/graphql": "workspace:*",
		"@pluxel/test": "link:../pluxel/packages/test",
		"@pluxel/websocket": "workspace:*",
		"@pluxel/wretch": "workspace:*",
		"@repobuddy/biome": "^2.3.1",
		"@tabler/icons-react": "^3.36.1",
		"@types/bun": "^1.3.8",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"pluxel-plugin-bot-core": "workspace:*",
		"pluxel-plugin-kv": "workspace:*",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"tsdown": "0.20.1",
		"turbo": "^2.8.0",
		"typescript": "^5.9.3",
		"unplugin-macros": "^0.18.7",
		"vitest": "3.2.4"
	},
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mantine/core": "^8.3.1",
				"@mantine/dates": "^8.3.1",
				"@mantine/hooks": "^8.3.1",
				"@mantine/modals": "^8.3.1",
				"@mantine/notifications": "^8.3.1",
				"@tanstack/react-form": "^1.23.0",
				"@tabler/icons-react": "^3.35.0",
				"react": "^19.1.1",
				"react-dom": "^19.1.1"
			}
		},
		"overrides": {
			"vite": "8.0.0-beta.5"
		}
	},
	"packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}

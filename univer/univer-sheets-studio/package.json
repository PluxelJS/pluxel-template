{
	"$schema": "https://market.pluxel.dev/schema/package.json",
	"name": "pluxel-plugin-univer-sheets-studio",
	"version": "0.1.0",
	"description": "Univer Sheets studio: a focused UI for programmatic sheet edits (future: ax-assisted editing).",
	"type": "module",
	"exports": {
		".": {
			"@pluxel/hmr": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"src/ui",
		"!**/*.map"
	],
	"scripts": {
		"build": "pluxel build",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@univerjs/core": "^0.10.0",
		"pluxel-plugin-univer-sheets": "workspace:*"
	},
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		},
		"access": "public",
		"provenance": true
	},
	"pluxel": {
		"dependOn": {
			"required": [
				"pluxel-plugin-univer-sheets"
			],
			"optional": []
		}
	}
}

{
  "$schema": "https://market.pluxel.dev/schema/package.json",
  "name": "pluxel-plugin-meme-worker",
  "version": "0.1.0",
  "description": "Tinypool-based meme generator service",
  "type": "module",
  "exports": {
    "./meme-worker": {
      "@pluxel/hmr": "./src/meme-worker.ts",
      "default": "./dist/meme-worker.mjs"
    },
    "./worker": {
      "@pluxel/hmr": "./src/worker.mjs",
      "default": "./dist/worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/meme-worker.ts",
  "files": [
    "dist",
    "!**/*.map"
  ],
  "scripts": {
    "build": "pluxel build"
  },
  "dependencies": {
    "tinypool": "^1.0.1"
  },
  "peerDependencies": {
    "pluxel-plugin-napi-rs": "workspace:^"
  },
  "publishConfig": {
    "exports": {
      "./meme-worker": "./dist/meme-worker.mjs",
      "./worker": "./dist/worker.mjs",
      "./package.json": "./package.json"
    }
  },
  "pluxel": {
    "dependOn": {
      "required": [],
      "optional": [
        "pluxel-plugin-napi-rs"
      ]
    }
  }
}